{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/analyze.js": {
      "maxDuration": 60
    },
    "api/dashboard.js": {
      "maxDuration": 15
    },
    "api/seed.js": {
      "maxDuration": 60
    },
    "api/observatory.js": {
      "maxDuration": 30
    },
    "api/insights.js": {
      "maxDuration": 40
    }
  },
  "headers": [
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/d/:token",
      "destination": "/dashboard.html"
    },
    {
      "source": "/observatory",
      "destination": "/observatory.html"
    }
  ]
}
